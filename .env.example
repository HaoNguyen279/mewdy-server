# Supabase PostgreSQL connection strings.
# DATABASE_URL: app runtime; Supabase transaction pooler (port 6543) is supported.
# DIRECT_URL: Prisma CLI/migrations; use the session pooler (port 5432) if direct IPv6
# connectivity is unavailable. These are examples of connection modes, not credentials.
DATABASE_URL=
DIRECT_URL=

# Prisma ORM 7 uses the pg driver's pool settings; URL parameter connection_limit is ignored.
# Keep this aligned with the Supabase connection capacity and number of API replicas.
DATABASE_POOL_MAX=1

# Upstash Redis TCP connection string from Connect > TCP, with TLS (rediss://).
REDIS_URL=

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Firebase configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Host ports
API_PORT=3000
PORT=3000

# Internal Docker Compose URL for the LiteLLM proxy. Do not expose the proxy publicly.
LITELLM_BASE_URL=http://litellm:4000/v1
# LiteLLM master key; keep the real value in server secrets, never in client apps.
LITELLM_API_KEY=sk-e74367f122d1cdfbd7a0c0d994bcad1c3ad2bc7736611f46d2af8558a785c504
