# Copy to .env.grafana. These values are passed only to the Alloy container.
# Find URL and username in Grafana Cloud stack > Prometheus > Details.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
# Access policy token with metrics:write permission; do not commit the real token.
GRAFANA_CLOUD_API_TOKEN=

# Set a distinct value on each EC2, e.g. dating-server-ec2-1 and dating-server-ec2-2.
METRICS_INSTANCE_NAME=dating-server-ec2-1

# Compose API: api:9464. Host-run local API: host.docker.internal:9464.
METRICS_SCRAPE_TARGET=api:9464
